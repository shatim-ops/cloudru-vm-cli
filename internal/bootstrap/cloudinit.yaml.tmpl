#cloud-config
package_update: true
package_upgrade: true

packages:
  - apt-transport-https
  - ca-certificates
  - curl
  - gnupg
  - lsb-release

write_files:
  - path: /etc/docker/daemon.json
    content: |
      {
        "log-driver": "json-file",
        "log-opts": {
          "max-size": "{{.DockerLogMax}}",
          "max-file": "3"
        }
      }

runcmd:
  # Install Docker
  - curl -fsSL https://get.docker.com | sh
  # Install Docker Compose plugin
  - mkdir -p /usr/local/lib/docker/cli-plugins
  - curl -fsSL "https://github.com/docker/compose/releases/download/{{.ComposeVersion}}/docker-compose-linux-$(uname -m)" -o /usr/local/lib/docker/cli-plugins/docker-compose
  - chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
  # Configure swap
  - fallocate -l {{.SwapSizeMB}}M /swapfile
  - chmod 600 /swapfile
  - mkswap /swapfile
  - swapon /swapfile
  - echo '/swapfile none swap sw 0 0' >> /etc/fstab
  # Configure firewall
  - ufw default deny incoming
  - ufw default allow outgoing
{{- range .Ports}}
  - ufw allow {{.}}/tcp
{{- end}}
  - ufw --force enable
  # Create app directory
  - mkdir -p /opt/app

users:
  - name: deploy
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - {{.SSHPublicKey}}
    groups: docker
